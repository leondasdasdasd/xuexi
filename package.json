{
  "private": true,
  "packageManager": "npm@8.19.4",
  "engines": {
    "node": "16.x",
    "npm": "8.x"
  },
  "scripts": {
    "prepare": "husky install",
    "dev": "vite --mode mock --host 0.0.0.0 --port 8000",
    "dev:daily": "vite --mode daily-local --host 0.0.0.0 --port 8000",
    "dev:local": "vite --mode local-backend --host 0.0.0.0 --port 8000",
    "dev:prod": "vite --mode production-local --host 0.0.0.0 --port 8000",
    "build:daily": "npm run typecheck && vite build --mode daily",
    "build": "npm run typecheck && vite build --mode production",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:stats": "eslint \"src/**/*.{js,jsx,ts,tsx}\" -f stats",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "lint:style": "stylelint \"src/**/*.{css,less}\" \"public/**/*.css\"",
    "lint:style:fix": "npm run lint:style -- --fix",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "duplication:scan": "jscpd src --format javascript,typescript --min-lines 3 --min-tokens 25 --mode weak --reporters console,json --output .jscpd --gitignore --exitCode 0 --ignore \"src/models/**,**/*.test.js,**/*.test.jsx,**/*.test.ts,**/*.test.tsx\"",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint:staged:hook": "lint-staged --config .lintstagedrc.husky.json",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css,less,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css,less,md}\"",
    "start:daily": "npm run dev:daily",
    "preview": "vite preview --mode production-local --host 0.0.0.0 --port 8000"
  },
  "dependencies": {
